{
  "name": "Motion Capture GUI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq libgl1 libgles2 libegl1 && pip install --user -r requirements.txt && echo 'DONE'",
  "postAttachCommand": "python main.py",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop GUI",
      "onAutoForward": "openPreview"
    }
  }
}
